{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "env": {
    "node": true
  },
  "plugins": ["typescript", "unicorn", "oxc"],
  "rules": {
    "no-console": "error",
    "typescript/no-explicit-any": "error",
    "unicorn/filename-case": [
      "error",
      {
        "cases": {
          "kebabCase": true
        }
      }
    ]
  },
  "ignorePatterns": ["node_modules/**"]
}
